# AAA: AlphA AI 환경 설정

# ===================
# 앱 설정
# ===================
APP_NAME="AAA: AlphA AI"
DEBUG=false

# ===================
# LLM 제공자 선택
# ===================
# "openai" 또는 "gemini" 중 선택
LLM_PROVIDER=openai

# ===================
# OpenAI 설정 (LLM_PROVIDER=openai 일 때)
# ===================
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ===================
# Gemini 설정 (LLM_PROVIDER=gemini 일 때)
# ===================
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ===================
# 임베딩 설정 (로컬 모델 - 무료)
# ===================
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu

# ===================
# 데이터베이스 경로 (Railway 볼륨 지원)
# ===================
# 기본값: ./data 디렉토리 사용
DATA_DIR=./data

# 전체 경로 사용 시 (Railway 볼륨 마운트)
# SQLITE_PATH=/app/data/app.db
# CHROMA_DIR=/app/data/chroma

# 상대 경로 사용 시 (DATA_DIR 기준)
SQLITE_PATH=app.db
CHROMA_DIR=chroma

# ===================
# 메모리 설정
# ===================
MEMORY_TOP_K=5
MEMORY_MIN_CONFIDENCE=0.4
MEMORY_DEDUP_THRESHOLD=0.05

# ===================
# CORS 설정
# ===================
# 배포 환경 프론트엔드 URL (localhost:3000은 항상 허용됨)
# FRONTEND_ORIGIN=https://app.yourdomain.com

# ===================
# Google OAuth 설정
# ===================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# 로컬 개발:
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/calendar/auth/callback

# Railway 배포 시:
# GOOGLE_REDIRECT_URI=https://api.yourdomain.com/calendar/auth/callback

GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar
